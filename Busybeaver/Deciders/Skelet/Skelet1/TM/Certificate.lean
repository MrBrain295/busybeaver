import Busybeaver.Deciders.Skelet.Skelet1.Cert.Chain
import Busybeaver.Deciders.Skelet.Skelet1.Lazy.Bridge
import Busybeaver.Deciders.Skelet.Skelet1.TM.Final

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace Sk1.Cert

def frameAt {R : Type} (T : List Sk1.LS) (c : Sk1.St R) : Sk1.St R :=
  ⟨c.right, Sk1.substT T c.l, c.r⟩

theorem joined_0 : ∃ T, Sk1.LS.tl ∉ T ∧ Sk1.Steps Sk1.checkedOps Sk1.Cert.C0000.c0 (frameAt T Sk1.Cert.C0000.c4) := by
  have hNo : Sk1.LS.tl ∉ Sk1.Cert.C0000.c4.l := by simp [Sk1.Cert.C0000.c4]
  refine ⟨[], by simp, ?_⟩
  simpa [frameAt, Sk1.Cert.C0000.c0, Sk1.lazyInit, Sk1.substT_of_not_mem hNo] using filePath_0

theorem joined_1 : ∃ T, Sk1.LS.tl ∉ T ∧ Sk1.Steps Sk1.checkedOps Sk1.Cert.C0000.c0 (frameAt T Sk1.Cert.C0001.c4) := by
  obtain ⟨T, hT, hprev⟩ := joined_0
  obtain ⟨T', hT', hglue⟩ := Sk1.glueL_sound Sk1.Cert.C0001.g T hT
  have hp : Sk1.Cert.C0001.p = Sk1.Cert.C0000.c4 := rfl
  have hbridge : frameAt T Sk1.Cert.C0000.c4 = frameAt T' Sk1.Cert.C0001.c0 := by
    rw [← hp]
    change (⟨Sk1.Cert.C0001.p.right, Sk1.substT T Sk1.Cert.C0001.p.l, Sk1.Cert.C0001.p.r⟩ : Sk1.St Sk1.RT) = ⟨Sk1.Cert.C0001.p.right, Sk1.substT T' Sk1.Cert.C0001.c0.l, Sk1.Cert.C0001.p.r⟩
    exact congrArg (fun l : List Sk1.LS => (⟨Sk1.Cert.C0001.p.right, l, Sk1.Cert.C0001.p.r⟩ : Sk1.St Sk1.RT)) hglue
  have hnext : Sk1.Steps Sk1.checkedOps (frameAt T' Sk1.Cert.C0001.c0) (frameAt T' Sk1.Cert.C0001.c4) := by
    apply Sk1.steps_frame filePath_1 T'
    intro _; simp [Sk1.Cert.C0001.c4]
  rw [← hbridge] at hnext
  exact ⟨T', hT', hprev.trans hnext⟩


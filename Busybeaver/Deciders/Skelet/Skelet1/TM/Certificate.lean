namespace Sk1.TM

theorem certified_nonhalt : ¬ Halts init := by
  obtain ⟨T, hT, hrun⟩ := Sk1.Cert.joined_1337
  have hstart : Sk1.Cert.C0000.c0 = Sk1.lazyInit := rfl
  rw [hstart] at hrun
  have hgood : (Sk1.lazyInit.r).Good ∧ (Sk1.lazyInit.r).den.isSome := by
    constructor
    · exact RT.ofList_good [.P]
    · rw [RT.ofList_den]; simp [eagerOps, ePush]
  obtain ⟨safeEnd, hs, _⟩ := Sk1.checked_steps_lift hrun hgood
  have hc : (Sk1.Cert.frameAt T Sk1.Cert.C1337.c1).r.Good ∧       (Sk1.Cert.frameAt T Sk1.Cert.C1337.c1).r.den.isSome := by
    have hr := congrArg (fun c : Sk1.St Sk1.RT => c.r) hs
    rw [← hr]
    simpa [SafeRT.forget] using safeEnd.r.property
  have heager := Sk1.checked_init_steps_sound hrun hc
  have hview : RT.view Sk1.Cert.C1337.c1.r = Sk1.Kc := by decide +kernel
  let final : Sk1.St (List Sk1.RI) := ⟨Sk1.Cert.C1337.c1.right, Sk1.substT T Sk1.Cert.C1337.c1.l, RT.view Sk1.Cert.C1337.c1.r⟩
  have hright : final.right = true := by simp [final, Sk1.Cert.C1337.c1]
  have hhead : final.l.head? = some Sk1.LS.C0 := by rfl
  have hleft : ∃ Y, final.l = Sk1.LS.C0 :: Y := by
    cases hl : final.l with
    | nil => simp [hl] at hhead
    | cons x xs =>
      simp only [hl, List.head?] at hhead
      have hx : x = Sk1.LS.C0 := Option.some.inj hhead
      subst x; exact ⟨xs, hl⟩
  obtain ⟨Y, hY⟩ := hleft
  have hrightTape : final.r = Sk1.Kc := by
    simpa [final] using hview
  have hfinal : final = ⟨true, Sk1.LS.C0 :: Y, Sk1.Kc⟩ := by
    cases final with
    | mk right l r =>
      simp only at hright hY hrightTape
      subst right; subst l; subst r; rfl
  rw [hfinal] at heager
  exact nonhalt_of_reaches_cycle ⟨Y, heager⟩

end Sk1.TM
